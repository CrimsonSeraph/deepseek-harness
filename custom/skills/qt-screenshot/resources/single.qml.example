// single.qml.example — 单窗口截图入口模板（示例，需按被测应用改造）
//
// 用法：复制成工作目录下的 templates/single.qml，然后由 shoot.sh 用 sed 改写下面三行标记：
//   property int targetWidth:  <宽>
//   property int targetHeight: <高>
//   property string kind:      "desktop" | "mobile"
// 这三行是 shoot.sh 的硬约定：缺任何一行，shoot.sh 会直接以退出码 3 失败，
// 而不是按错误的尺寸静默截图。
//
// 另外一条硬约定：窗口标题必须包含约定的标识（默认 SHOTWIN，见窗口的 title 绑定），
// cap.ps1 靠它 + 进程 PID 定位窗口。
//
// 只显示 kind 对应的那个窗口；另一个保持 visible: false。
// 注意：不要给两个窗口都设 visible: true —— 那样会同时出现两个同标题窗口，
// 抓图时挑到哪一个取决于面积大小，结果不可预期。

import QtQuick
import QtQuick.Controls
import Schedule 1.0   // ← 改成被测应用的模块名（与 run_shots.sh --module 一致）

Item {
    id: harness
    visible: false

    // ------------------------------------------------------------ 假数据
    // 真实项目里把这些换成被测页面需要的 model / 全局对象。
    ListModel {
        id: sessionData
        ListElement {
            courseId: "c1"; courseName: "高等数学 A"; teacher: "张老师"; location: "教一 101"
            color: "#4C8DFF"; dayName: "周一"; startTime: "08:00"; endTime: "09:35"
            startSlot: 1; endSlot: 2; weeksDisplay: "1-16"
        }
        ListElement {
            courseId: "c2"; courseName: "大学英语（听说）"; teacher: "李老师"; location: "外语楼 305"
            color: "#2E9E7B"; dayName: "周二"; startTime: "10:00"; endTime: "11:35"
            startSlot: 3; endSlot: 4; weeksDisplay: "1-16/2"
        }
        ListElement {
            courseId: "c3"; courseName: "数据结构与算法"; teacher: "王老师"; location: "计算机楼 201"
            color: "#D97706"; dayName: "周三"; startTime: "08:00"; endTime: "11:35"
            startSlot: 1; endSlot: 4; weeksDisplay: "1-12"
        }
    }

    QtObject {
        id: scheduleMock
        property var sessionModel: sessionData
        property var dayOptions: [
            { "label": "整周", "value": 0 },
            { "label": "周一", "value": 1 },
            { "label": "周二", "value": 2 }
        ]
        property int selectedDay: 0
        function day_name(day) { return day === 1 ? "周一" : "周二" }
    }

    property var schedule: scheduleMock
    property var bridge: QtObject {}

    // ------------------------------------------------------------ 被截图窗口
    property int targetWidth: 1180
    property int targetHeight: 760
    property string kind: "desktop"

    MainDesktop {
        id: desktopWindow
        title: "SHOTWIN"          // ← 约定的标题标识，cap.ps1 靠它定位窗口
        visible: kind === "desktop"
        width: targetWidth
        height: targetHeight
    }

    MainMobile {
        id: mobileWindow
        title: "SHOTWIN"
        visible: kind === "mobile"
        width: targetWidth
        height: targetHeight
    }
}
