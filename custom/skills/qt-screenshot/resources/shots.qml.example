// shots.qml.example — 离屏（offscreen）烟测入口模板（示例，需按被测应用改造）
//
// 用途：在真正开窗口抓图之前，先用 QT_QPA_PLATFORM=offscreen 跑一遍全部目标尺寸，
// 确认「所有尺寸都能加载、没有 QML 运行期错误、进程能自己退出」。
// run_shots.sh 会检查它的退出码、日志里的 QML 错误，以及跑完后有没有残留 qml.exe。
//
// 与 single.qml 的区别：这里把所有尺寸都试一遍但不截图（不依赖窗口管理器），
// 只负责尽早暴露 TypeError / ReferenceError / 绑定循环这类问题。

import QtQuick
import Schedule 1.0   // ← 改成被测应用的模块名

Item {
    id: harness

    property var schedule: scheduleMock
    property var bridge: QtObject {}

    QtObject {
        id: scheduleMock
        property var sessionModel: ListModel {}
        property var dayOptions: [{ "label": "整周", "value": 0 }]
        property int selectedDay: 0
        function day_name(day) { return "整周" }
    }

    property bool useMobile: false
    property var jobs: [
        { "mobile": false, "w": 1180, "h": 760, "name": "desktop-1180x760" },
        { "mobile": false, "w": 700, "h": 500, "name": "desktop-700x500" },
        { "mobile": true, "w": 390, "h": 844, "name": "mobile-390x844" },
        { "mobile": true, "w": 320, "h": 568, "name": "mobile-320x568" }
    ]
    property int jobIndex: -1

    MainDesktop {
        id: desktopWindow
        visible: false
    }

    MainMobile {
        id: mobileWindow
        visible: false
    }

    Timer {
        id: timer
        interval: 300
        repeat: false
        property string shotName: ""
        onTriggered: {
            var target = harness.useMobile ? mobileWindow : desktopWindow;
            console.log("sized " + timer.shotName + " " + Math.round(target.width) + "x" + Math.round(target.height));
            harness.next_job();
        }
    }

    function next_job() {
        jobIndex += 1;
        if (jobIndex >= jobs.length) {
            console.log("ALL DONE");
            Qt.quit();          // ← 必须自己退出：退不掉会被 run_shots.sh 判为「退出路径不干净」
            return;
        }
        var job = jobs[jobIndex];
        useMobile = job.mobile;
        desktopWindow.visible = !job.mobile;
        mobileWindow.visible = job.mobile;
        var target = job.mobile ? mobileWindow : desktopWindow;
        target.width = job.w;
        target.height = job.h;
        timer.shotName = job.name;
        timer.restart();
    }

    Component.onCompleted: next_job()
}
